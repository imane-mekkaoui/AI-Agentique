# Copier vers .env et adapter. Ne jamais committer .env.

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=maintidoc_passages

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# LLM compatible OpenAI (Ollama par défaut)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=3

CATALOG_PATH=data/catalog.yaml
CORPUS_DIR=data/corpus
IMAGES_DIR=data/extracted_images
CLIP_MODEL=clip-ViT-B-32
MAX_IMAGES_PER_DOC=30
QDRANT_CLIP_COLLECTION=maintidoc_clip_images
VLM_MODEL=qwen2.5vl:3b
OLLAMA_URL=http://127.0.0.1:11434
RERANKER_MODE=base
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

LOG_LEVEL=INFO
MAINTIDOC_API_URL=http://127.0.0.1:8001
